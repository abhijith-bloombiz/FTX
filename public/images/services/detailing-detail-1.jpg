<svg width="1200" height="800" viewBox="0 0 1200 800" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="1200" height="800" fill="#0e0e0e"/>
    <!-- Background Grid -->
    <path d="M0 100H1200M0 200H1200M0 300H1200M0 400H1200M0 500H1200M0 600H1200M0 700H1200" stroke="#a4d65e" stroke-opacity="0.05" stroke-width="1"/>
    <path d="M100 0V800M200 0V800M300 0V800M400 0V800M500 0V800M600 0V800M700 0V800M800 0V800M900 0V800M1000 0V800M1100 0V800" stroke="#a4d65e" stroke-opacity="0.05" stroke-width="1"/>
    
    <!-- Ambient Radial Glow -->
    <circle cx="600" cy="400" r="350" fill="#a4d65e" fill-opacity="0.08"/>

    <!-- Stylized Supercar Silhouette -->
    <path d="M200 520 L320 480 L480 340 L720 340 L880 440 L1000 480 L1040 520 Z" fill="#1f1f1f" stroke="#a4d65e" stroke-width="3"/>
    <!-- Windshield -->
    <path d="M490 350 L710 350 L820 440 L440 440 Z" fill="#a4d65e" fill-opacity="0.15" stroke="#a4d65e" stroke-width="1.5"/>
    <!-- Headlight Beam -->
    <polygon points="1000,480 1200,420 1200,560 1040,520" fill="url(#beamGrad)" opacity="0.6"/>
    
    <!-- Wheels -->
    <circle cx="360" cy="520" r="70" fill="#000" stroke="#a4d65e" stroke-width="4"/>
    <circle cx="360" cy="520" r="40" fill="#a4d65e" fill-opacity="0.3"/>
    <circle cx="840" cy="520" r="70" fill="#000" stroke="#a4d65e" stroke-width="4"/>
    <circle cx="840" cy="520" r="40" fill="#a4d65e" fill-opacity="0.3"/>

    <!-- FTX Badge Box -->
    <rect x="60" y="60" width="340" height="48" rx="4" fill="#131313" stroke="#a4d65e" stroke-width="1.5"/>
    <text x="80" y="90" fill="#a4d65e" font-family="sans-serif" font-weight="bold" font-size="16" letter-spacing="3">PH BALANCED</text>

    <!-- Title Label -->
    <text x="60" y="720" fill="#FFFFFF" font-family="sans-serif" font-weight="900" font-size="32" letter-spacing="2">INTERIOR LEATHER SPA</text>
    <text x="60" y="750" fill="#C6C6C6" font-family="sans-serif" font-weight="500" font-size="16" letter-spacing="1">FTX – FIRST TORQUE X AUTOMOTIVE STUDIO</text>

    <defs>
      <linearGradient id="beamGrad" x1="1000" y1="490" x2="1200" y2="490" gradientUnits="userSpaceOnUse">
        <stop stop-color="#a4d65e" stop-opacity="0.8"/>
        <stop offset="1" stop-color="#a4d65e" stop-opacity="0"/>
      </linearGradient>
    </defs>
  </svg>