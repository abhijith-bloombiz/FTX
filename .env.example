# -----------------------------------------------------------------------------
# FTX Automotive Protection Studio — Environment Variables Template
# -----------------------------------------------------------------------------

# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0/ftx_db"

# Admin Initial Credentials
ADMIN_EMAIL="admin@ftx.ae"
ADMIN_INITIAL_PASSWORD="ChangeThisToAStrongPassword123!"

# NextAuth / Jose JWT Token Secret (Generate a strong 256-bit random string)
JWT_SECRET="your-strong-production-jwt-secret-key-here"

# Public Site URL & Canonical Domain
NEXT_PUBLIC_SITE_URL="https://ftx.ae"

# Optional Contact & WhatsApp Overrides
NEXT_PUBLIC_WHATSAPP_NUMBER="971500000000"
NEXT_PUBLIC_GOOGLE_MAPS_URL="https://maps.google.com/?q=FTX+First+Torque+X"
